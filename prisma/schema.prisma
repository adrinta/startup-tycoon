// Schema Prisma 7 untuk Startup Tycoon.
// URL database dibaca dari prisma7.config.ts (DATABASE_URL / DIRECT_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Identitas pemain (selaras dengan Supabase Auth: id = auth.users.id).
model User {
  id            String   @id @db.Uuid
  email         String   @unique
  fullName      String?  @map("full_name")
  avatarUrl     String?  @map("avatar_url")
  startupName   String?  @map("startup_name")
  founderAvatar String?  @map("founder_avatar")
  role          String   @default("student")
  revenue       Int      @default(0)
  activeUsers   Int      @default(0) @map("active_users")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  progress  UserProgress[]
  inventory UserInventory[]
  lecturedClasses Class[] @relation("LecturerClasses")
  classMemberships ClassMember[]
  attempts QuestAttempt[]

  @@map("users")
}

/// Status penyelesaian misi per pemain.
/// `questId` memakai id konten ("1.1", "1.7") — katalog quest masih
/// version-controlled di kode (seeding ke tabel `quests` menyusul di M7).
model UserProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  questId     String    @map("quest_id")
  isCompleted Boolean   @default(true) @map("is_completed")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@map("user_progress")
}

/// Katalog barang dekorasi (di-seed dari src/content/shop/items.ts).
model InventoryItem {
  id       String  @id
  name     String
  emoji    String?
  category String
  cost     Int
  buffs    Json?

  userInventory UserInventory[]

  @@map("inventory_items")
}

/// Kepemilikan dekorasi per pemain.
model UserInventory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  itemId      String   @map("item_id")
  purchasedAt DateTime @default(now()) @map("purchased_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("user_inventory")
}

/// Kelas yang dibuat pengajar (M7: dashboard dosen).
model Class {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  joinCode   String   @unique @map("join_code")
  lecturerId String   @map("lecturer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  lecturer User          @relation("LecturerClasses", fields: [lecturerId], references: [id], onDelete: Cascade)
  members  ClassMember[]

  @@map("classes")
}

/// Keanggotaan mahasiswa pada kelas.
model ClassMember {
  id       String   @id @default(uuid()) @db.Uuid
  classId  String   @map("class_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@map("class_members")
}

/// Riwayat percobaan audit per misi (metrik akurasi & bottleneck).
model QuestAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  questId   String   @map("quest_id")
  passed    Boolean
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quest_attempts")
}
